{
  "rules": {
    "1": {
      "name": "Network missing AuthorityRef",
      "message": "Network is missing AuthorityRef",
      "severity": "ERROR",
      "xpath": "//Network[not(AuthorityRef)]"
    },
    "2": {
      "name": "Network missing Name on Network",
      "message": "Network is missing Name",
      "severity": "ERROR",
      "xpath": "//Network[not(Name) or normalize-space(Name) = '']"
    },
    "3": {
      "name": "Network missing Name on GroupOfLines",
      "message": "GroupOfLines is missing Name",
      "severity": "ERROR",
      "xpath": "//Network/groupsOfLines/GroupOfLines[not(Name) or normalize-space(Name) = '']"
    },
    "AUTHORITY_2": {
      "name": "Authority missing Name",
      "message": "Authority is missing Name",
      "severity": "ERROR",
      "xpath": "//organisations/Authority[not(Name) or normalize-space(Name) = '']"
    },
    "OPERATOR_2": {
      "name": "Operator missing Name",
      "message": "Operator is missing Name",
      "severity": "ERROR",
      "xpath": "//organisations/Operator[not(Name) or normalize-space(Name) = '']"
    },
    "1_B": {
      "name": "Network missing Name",
      "message": "Network must have a Name",
