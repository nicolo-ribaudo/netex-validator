      "severity": "WARNING",
      "xpath": "//operators/Operator[not(ContactDetails)]"
    },
    "AUTHORITY_1": {
      "name": "Authority missing Name",
      "message": "Authority must have a Name",
      "severity": "ERROR",
      "xpath": "//organisations/Authority[not(Name) or normalize-space(Name) = '']"
    },
    "AUTHORITY_MISSING_NAME": {
      "name": "Authority missing Name",
      "message": "Authority must have Name",
      "severity": "ERROR",
      "xpath": "//organisations/Authority[not(Name) or normalize-space(Name) = '']"
